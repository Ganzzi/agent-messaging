# Agent Messaging Test Environment Configuration
# These are the QA service addresses for host-local test execution

# PostgreSQL - port 5433 for host-local tests
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend123
POSTGRES_DB=agent_messaging_test
POSTGRES_DATABASE=agent_messaging_test
POSTGRES_SSL=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
